    "# PRC: Recall (=TPR) vs Precision (=PPV)\n",
    "# -------------------------\n",
    "pr = pf[[\"tpr\", \"ppv\", \"tpr_lower\", \"ppv_lower\", \"tpr_upper\", \"ppv_upper\"]].copy()\n",
